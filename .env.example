# -------------------------------------------------------------
# HandAI REST API Configuration
# -------------------------------------------------------------

# 1. Your Google Gemini API Key (Secret - never shared with clients)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourActualGoogleGeminiApiKeyHere

# 2. Client Authentication Keys (Give these to users/teams who call your API)
# Set to "*" to allow public unauthenticated access
# Or comma-separated list of keys, e.g.: handai_live_abc123,handai_client_xyz789
ALLOWED_API_KEYS=*

# 3. Model Configuration
DEFAULT_MODEL=gemini-2.5-flash

# 4. Server Host & Port
HOST=0.0.0.0
PORT=8000
